{
  "expo": {
    "name": "DemoAlam",
    "slug": "demoalam",
    "version": "1.0.0",
    "scheme": "demoalam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563A9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563A9"
      },
      "package": "com.demoalam.app",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResources": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
